# ---------------------------------------------------------------------------
# Family Finance — variáveis de ambiente (modelo)
#
# Copie para `.env` (desenvolvimento) e preencha. NUNCA commite `.env`.
# Homologação e produção usam segredos separados, fornecidos pelo cofre do
# ambiente — ver docs/02-ENVIRONMENTS.md.
#
# Todas as variáveis abaixo são validadas no startup do backend
# (apps/api/src/config/env.ts). Faltando ou inválida = processo não sobe.
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=debug

# --- HTTP ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3400
# Origens permitidas (CSV). Em produção, nunca "*".
API_CORS_ORIGINS=http://localhost:8081

# --- Banco de dados --------------------------------------------------------
# Runtime da aplicação: role ff_app, sujeito a RLS (NOBYPASSRLS).
DATABASE_URL=postgres://ff_app:ff_dev_password@localhost:5435/family_finance
# Serviço de autenticação: role ff_auth, única conexão que enxerga credenciais.
DATABASE_AUTH_URL=postgres://ff_auth:ff_dev_password@localhost:5435/family_finance
# Usuário de migração (DDL). Separado dos dois acima.
DATABASE_MIGRATION_URL=postgres://ff_migrator:ff_dev_password@localhost:5435/family_finance
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# Certificado raiz do banco, em PEM codificado em base64. Vazio = usar as CAs
# públicas do sistema, que é o caso do Postgres local (sem SSL) e de provedores
# com certificado público.
#
# Necessário quando o provedor usa CA própria — o pooler do Supabase usa a
# "Supabase Root 2021 CA", auto-assinada. Sem isto a conexão falha com
# SELF_SIGNED_CERT_IN_CHAIN. A alternativa (desligar a verificação) deixaria a
# credencial do banco à mercê de quem estivesse no meio do caminho.
#
# Gere com:
#   node -e "console.log(require('fs').readFileSync('infra/supabase/prod-ca-2021.crt').toString('base64'))"
DATABASE_SSL_CA=

# --- Autenticação ----------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-de-48-bytes-em-base64url
JWT_REFRESH_SECRET=troque-por-outro-segredo-de-48-bytes-em-base64url
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=family-finance

# --- Observabilidade -------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Ponte de links de e-mail ----------------------------------------------
# Base https pública desta API, sem barra no fim. É dela que sai o link dos
# e-mails: <base>/abrir/verificar-email?token=...
# Vazia em desenvolvimento: os e-mails caem no deep link cru familyfinance://,
# que dá para colar à mão a partir do log. Em produção é OBRIGATÓRIA: nenhum
# cliente de e-mail transforma um esquema fora de http(s) em link clicável, e
# colar o texto no navegador dá "endereço inválido".
PUBLIC_BASE_URL=

# --- E-mail transacional (Resend) ------------------------------------------
# Vazio em desenvolvimento: o link de confirmação vai para o log e dá para
# testar o fluxo sem conta contratada. Em produção a chave é OBRIGATÓRIA --
# sem ela o cadastro cria contas que ninguém consegue confirmar, porque o
# token de verificação só existe naquele e-mail.
# Chave em https://resend.com/api-keys (permissão de envio basta).
RESEND_API_KEY=
# Remetente completo. O domínio precisa estar verificado no Resend.
EMAIL_FROM=Primate Wallet <nao-responda@primatetechnology.com>

# --- Storage de anexos (S3-compatível, bucket privado) ---------------------
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_TTL=300

# --- Testes ----------------------------------------------------------------
# Banco exclusivo dos testes de integração: eles dão TRUNCATE a cada arquivo, e
# o banco de desenvolvimento guarda o seed usado no gate visual. Deixe vazio
# para rodar no banco do DATABASE_URL (é o caso da CI, com Postgres efêmero).
# Prepare com: npm run db:test:prepare --workspace @ff/api
TEST_DATABASE_NAME=family_finance_test
