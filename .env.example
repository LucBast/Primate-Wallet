# ---------------------------------------------------------------------------
# Family Finance — variáveis de ambiente (modelo)
#
# Copie para `.env` (desenvolvimento) e preencha. NUNCA commite `.env`.
# Homologação e produção usam segredos separados, fornecidos pelo cofre do
# ambiente — ver docs/02-ENVIRONMENTS.md.
#
# Todas as variáveis abaixo são validadas no startup do backend
# (apps/api/src/config/env.ts). Faltando ou inválida = processo não sobe.
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=debug

# --- HTTP ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3400
# Origens permitidas (CSV). Em produção, nunca "*".
API_CORS_ORIGINS=http://localhost:8081

# --- Banco de dados --------------------------------------------------------
# Runtime da aplicação: role ff_app, sujeito a RLS (NOBYPASSRLS).
DATABASE_URL=postgres://ff_app:ff_dev_password@localhost:5435/family_finance
# Serviço de autenticação: role ff_auth, única conexão que enxerga credenciais.
DATABASE_AUTH_URL=postgres://ff_auth:ff_dev_password@localhost:5435/family_finance
# Usuário de migração (DDL). Separado dos dois acima.
DATABASE_MIGRATION_URL=postgres://ff_migrator:ff_dev_password@localhost:5435/family_finance
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Autenticação ----------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-de-48-bytes-em-base64url
JWT_REFRESH_SECRET=troque-por-outro-segredo-de-48-bytes-em-base64url
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=family-finance

# --- Observabilidade -------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Storage de anexos (S3-compatível, bucket privado) ---------------------
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_TTL=300

# --- Testes ----------------------------------------------------------------
# Banco exclusivo dos testes de integração: eles dão TRUNCATE a cada arquivo, e
# o banco de desenvolvimento guarda o seed usado no gate visual. Deixe vazio
# para rodar no banco do DATABASE_URL (é o caso da CI, com Postgres efêmero).
# Prepare com: npm run db:test:prepare --workspace @ff/api
TEST_DATABASE_NAME=family_finance_test
