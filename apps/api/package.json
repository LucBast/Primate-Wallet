{
  "name": "@ff/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate.mjs down",
    "migrate:reset": "node scripts/migrate.mjs reset",
    "db:test:prepare": "node scripts/create-test-db.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@ff/api-contracts": "*",
    "@ff/domain": "*",
    "@ff/validation": "*",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^10.69.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "jose": "^6.2.8",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ff/test-fixtures": "*",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
